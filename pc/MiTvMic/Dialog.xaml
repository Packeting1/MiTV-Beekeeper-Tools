<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        BorderBrush="#3A3E45" BorderThickness="1"
        Background="#1E2023" Foreground="#EDEFF4"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#EDEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA4B5"/>
    <SolidColorBrush x:Key="AccentButton" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ControlFill" Color="#2C3036"/>
    <SolidColorBrush x:Key="ControlLine" Color="#3E434A"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource ControlFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Hl" CornerRadius="4" Background="#00FFFFFF"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hl" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hl" Property="Background" Value="#2E000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentButton}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentButton}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <StackPanel Margin="26,24,26,22">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{StaticResource TextPrimary}"/>
      <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                 Foreground="{StaticResource TextSecondary}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button x:Name="NoBtn" IsCancel="True" Margin="0,0,10,0"/>
        <Button x:Name="YesBtn" IsDefault="True" Style="{StaticResource BtnAccent}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
